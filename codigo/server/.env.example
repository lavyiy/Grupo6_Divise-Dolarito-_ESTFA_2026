# ── Variables de entorno del servidor (Divise) ──
# Copiar este archivo como .env dentro de /codigo/server y completar con los valores reales

PORT=5000

# ── Base de datos PostgreSQL en Supabase ──
# Obtenela en Supabase Dashboard → Settings → Database → Connection string (URI)
# Reemplazá [YOUR-PASSWORD] por la contraseña de tu base de datos
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# ── Seguridad JWT ──
JWT_SECRET=tu_clave_secreta_jwt_divise_2026

# ── URL del Frontend ──
FRONTEND_URL=http://localhost:5173

# ── Servicio de Emails: Gmail (Nodemailer) ──
# 1. Tu dirección de Gmail
# 2. Contraseña de aplicación de Google de 16 letras (Google Account -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones)
EMAIL_USER=tuemail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# También compatible con:
# GMAIL_USER=tuemail@gmail.com
# GMAIL_PASS=xxxx xxxx xxxx xxxx

# ── Brevo (Opcional como respaldo en Render) ──
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxx
# BREVO_SENDER=tuemail@gmail.com
