# ── Variables de entorno del servidor ──
# Copiar este archivo como .env dentro de /codigo/server y completar con los valores reales

PORT=5000
DATABASE_URL=postgresql://usuario:password@host:puerto/database
JWT_SECRET=tu_clave_secreta_aqui
FRONTEND_URL=http://localhost:5173

# ── Brevo (API HTTP — funciona en Render free) ──
# 1. Crear cuenta gratis: https://www.brevo.com
# 2. SMTP & API → API Keys → Generate a new API key
# 3. Pegar el valor aquí:
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxx
